---
import Base from '../../layouts/Base.astro';
import LeadForm from '../../components/LeadForm.astro';
import { publicLofts } from '../../lib/data';
import { stats } from '../../lib/stats';
import { datasetLd, breadcrumbLd, faqLd } from '../../lib/jsonld';
import { fmt } from '../../lib/price';

const all = publicLofts();
const s = stats(all);
const built = new Date().toISOString().slice(0, 10);
const crumbs = [{ name: 'Лофты Москвы', path: '/' }, { name: 'Цены на корпоратив 2026', path: '/ceny/korporativ-2026/' }];
const has = s.median30 != null;
const faq = [
  { q: 'Сколько стоит аренда лофта на корпоратив в Москве в декабре 2026?', a: has ? `Медиана по ${s.verified} проверенным площадкам — ${fmt(s.median30!)} за вечер на 30 человек (суббота, 18:00–23:00, с минимумом часов и уборкой). Диапазон: ${fmt(s.min30!)} – ${fmt(s.max30!)}.` : s.hour.median ? `По заявленным ставкам «от» у ${s.hour.count} лофтов медиана — ${fmt(s.hour.median)} в час, то есть от ${fmt(s.hour.median * 5)} за 5 часов без учёта минимума часов, уборки и декабрьских наценок. Проверенные итоговые цены появляются по мере обзвона площадок.` : 'Данные собираются; страница обновляется с каждой проверкой.' },
  { q: 'Как считалась цена за вечер?', a: 'Для каждой площадки запрашивали итоговую сумму на один сценарий: 30 гостей, суббота декабря, 18:00–23:00, включая минимум часов и уборку. Залог и пробковый сбор учитываются отдельно. Площадки без проверенной цены в расчёт не входят.' },
];
---
<Base title={`Сколько стоит корпоратив в лофте в Москве в 2026: ${has ? `медиана ${fmt(s.median30!)} за вечер по ${s.verified} площадкам` : 'исследование цен'} — LoftMap`}
      description={`Исследование цен на аренду лофтов для корпоратива в Москве: ${s.verified} проверенных площадок, цена за вечер на 30 человек, залоги, свой алкоголь и кейтеринг. Методика и открытые данные. Обновлено ${built}.`}
      jsonLd={[datasetLd(built, s.verified), breadcrumbLd(crumbs), faqLd(faq)]}>
  <nav class="text-sm text-ink/60 mb-3"><a href="/" class="hover:text-brick">Лофты Москвы</a> › Цены на корпоратив 2026</nav>
  <article class="prose-tight max-w-3xl">
    <h1 class="text-3xl sm:text-4xl font-bold tracking-tight">Сколько стоит корпоратив в лофте в Москве: цены декабря 2026</h1>
    <p class="text-sm text-ink/60">Обновлено {built} · в каталоге {s.total} лофтов, проверено {s.verified}, ставки «от» известны у {s.hour.count} · автор: LoftMap</p>
    {has ? (
      <p class="text-lg">Вечер в лофте на 30 человек в декабре 2026 стоит в среднем <strong>{fmt(s.median30!)}</strong> (медиана по {s.verified} площадкам, проверенным по телефону и в мессенджерах). Самый дешёвый вариант — {fmt(s.min30!)}, самый дорогой — {fmt(s.max30!)}. Это {fmt(Math.round(s.median30! / 30))} на гостя только за площадку; еда и напитки — сверху.</p>
    ) : (
      <p class="text-lg">Собираем проверенные цены по каждой площадке. Как только наберётся выборка, здесь появятся медианы по вместимости и округам. Данные обновляются с каждой проверкой.</p>
    )}

    {!has && s.hour.count > 0 && (
      <>
        <h2>Ставка «от» в час по данным сайтов площадок</h2>
        <p>Пока идёт проверка, ориентир — заявленные ставки «от» у {s.hour.count} лофтов из открытых источников: медиана <strong>{fmt(s.hour.median!)}/час</strong>. Это нижняя граница: минимум часов, уборка и наценки на декабрь в неё не входят, итог за вечер обычно в 1,5–2 раза выше ставки × часы.</p>
        <table>
          <thead><tr><th>Гостей</th><th>Лофтов</th><th>Медиана ставки «от»</th><th>Ориентир за 5 часов</th></tr></thead>
          <tbody>{s.hour.byCapacity.map((r) => <tr><td>{r.people}</td><td>{r.count}</td><td>{r.median ? fmt(r.median) + '/час' : '—'}</td><td>{r.median ? fmt(r.median * 5) : '—'}</td></tr>)}</tbody>
        </table>
        <table>
          <thead><tr><th>Округ</th><th>Лофтов</th><th>Медиана ставки «от»</th></tr></thead>
          <tbody>{s.hour.byDistrict.map((r) => <tr><td>{r.district}</td><td>{r.count}</td><td>{r.median ? fmt(r.median) + '/час' : '—'}</td></tr>)}</tbody>
        </table>
      </>
    )}
    <h2>Цена за вечер по количеству гостей{!has ? ' (проверенные площадки)' : ''}</h2>
    <table>
      <thead><tr><th>Гостей</th><th>Подходящих лофтов</th><th>Медиана за вечер</th><th>На гостя</th></tr></thead>
      <tbody>{s.byCapacity.map((r) => <tr><td>{r.people}</td><td>{r.count}</td><td>{r.median30 ? fmt(r.median30) : '—'}</td><td>{r.median30 ? fmt(Math.round(r.median30 / r.people)) : '—'}</td></tr>)}</tbody>
    </table>
    <p class="text-sm text-ink/60">Цена — за сценарий «30 гостей, суббота, 18:00–23:00», лофты отобраны по вместимости. У площадок на 100+ человек реальная цена на такую группу выше.</p>

    <h2>По округам Москвы</h2>
    <table>
      <thead><tr><th>Округ</th><th>Проверено</th><th>Медиана за вечер</th></tr></thead>
      <tbody>{s.byDistrict.map((r) => <tr><td>{r.district}</td><td>{r.count}</td><td>{r.median30 ? fmt(r.median30) : '—'}</td></tr>)}</tbody>
    </table>

    <h2>Условия, которые влияют на итог</h2>
    <ul class="list-disc pl-5 my-3 leading-relaxed">
      <li><strong>Минимум часов.</strong> Большинство лофтов не сдают меньше чем на 4–5 часов; ставка «от 1 500 ₽/час» на сайте площадки почти никогда не равна итогу.</li>
      <li><strong>Залог.</strong> {s.medianDeposit ? `Медиана — ${fmt(s.medianDeposit)}` : 'Обычно 10–20 тыс. ₽'}, возвращается после мероприятия.</li>
      <li><strong>Свой алкоголь.</strong> {s.shareOwnAlcohol != null ? `Разрешают ${s.shareOwnAlcohol}% проверенных площадок` : 'Разрешает большинство лофтов'}; часть берёт пробковый сбор 3–5 тыс. ₽.</li>
      <li><strong>Своя еда и кейтеринг.</strong> {s.shareOwnCatering != null ? `Разрешают ${s.shareOwnCatering}%` : 'Разрешает большинство'}.</li>
      <li><strong>Новогодняя наценка.</strong> На 20–31 декабря часть площадок поднимает ставку на 20–50%.</li>
    </ul>

    <h2>Методика</h2>
    <p>Кандидаты собраны из открытых источников (карты, сайты площадок, агрегаторы). Проверка — звонок или переписка с площадкой по единому сценарию: 30 гостей, суббота декабря, 18:00–23:00; записываем итоговую сумму с минимумом часов и уборкой, залог, пробковый сбор, условия по еде, шуму, а также свободные даты 10–30 декабря. Дата проверки указана в каждой карточке. Площадки без проверенной цены в статистику не входят. Сырые данные открыты: <a href="/data/lofts.json">lofts.json</a> (CC BY 4.0, при использовании — ссылка на loftmap.ru).</p>

    <h2>Что с этим делать</h2>
    <p>Смотрите <a href="/korporativ/">лофты на корпоратив со свободными датами</a>, фильтруйте по гостям и бюджету, считайте итог в калькуляторе на карточке. Или оставьте заявку — подберём 3–5 вариантов под дату.</p>
  </article>
  <div class="mt-10 max-w-3xl"><LeadForm /></div>
</Base>
