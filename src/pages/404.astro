---
import Base from '../layouts/Base.astro';
---
<Base title="Страница не найдена — LoftMap" description="Такой страницы нет. Перейдите в каталог лофтов Москвы." noindex>
  <div class="py-16 text-center">
    <h1 class="text-3xl font-bold">Страницы нет</h1>
    <p class="mt-3 text-ink/70">Возможно, лофт закрылся или адрес изменился.</p>
    <p class="mt-6"><a href="/katalog/" class="btn">Все лофты Москвы</a></p>
  </div>
</Base>
