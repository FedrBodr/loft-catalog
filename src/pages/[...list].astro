---
// Все списочные страницы (метро, округ, задача, вместимость, фичи) из одного шаблона.
import Base from '../layouts/Base.astro';
import LoftCard from '../components/LoftCard.astro';
import Filters from '../components/Filters.tsx';
import LeadForm from '../components/LeadForm.astro';
import { publicLofts } from '../lib/data';
import { listPages, metroLinks, MAX_CARDS, type ListPage } from '../lib/pages';
import MetroNav from '../components/MetroNav.astro';
import { breadcrumbLd, itemListLd } from '../lib/jsonld';
import { fmt } from '../lib/price';

export function getStaticPaths() {
  return listPages(publicLofts()).map((p) => ({ params: { list: p.path.slice(1, -1) }, props: { page: p } }));
}
const { page: p } = Astro.props as { page: ListPage };
const sorted = [...p.lofts].sort((a, b) => (a.status === 'verified' ? 0 : 1) - (b.status === 'verified' ? 0 : 1) || (a.price_evening_30 ?? 1e9) - (b.price_evening_30 ?? 1e9));
const shown = sorted.slice(0, MAX_CARDS);
const v = sorted.filter((l) => l.price_evening_30);
const intro = v.length
  ? `${p.h1}: ${p.lofts.length} площадок, из них ${v.length} с проверенной ценой за вечер — от ${fmt(Math.min(...v.map((l) => l.price_evening_30!)))} на 30 человек с учётом минимума часов и уборки. Контакты открыты, комиссии нет.`
  : `${p.h1}: ${p.lofts.length} площадок с адресами, метро и контактами. Проверенные цены появляются по мере обзвона.`;
---
<Base title={p.title} description={p.description} noindex={p.noindex} jsonLd={[breadcrumbLd(p.crumbs), itemListLd(p.h1, sorted)]}>
  <nav class="text-sm text-ink/60 mb-3">{p.crumbs.map((c, i) => <>{i > 0 && ' › '}<a href={c.path} class="hover:text-brick">{c.name}</a></>)}</nav>
  <h1 class="text-3xl font-bold tracking-tight">{p.h1}</h1>
  <p class="mt-3 text-lg text-ink/80 max-w-3xl">{intro}</p>
  <div class="mt-5"><Filters client:load total={shown.length} /></div>
  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">{shown.map((l) => <LoftCard loft={l} />)}</div>
  <MetroNav total={sorted.length} shown={shown.length} links={metroLinks(sorted)} />
  <div class="mt-10"><LeadForm /></div>
</Base>
