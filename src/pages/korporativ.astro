---
import Base from '../layouts/Base.astro';
import LoftCard from '../components/LoftCard.astro';
import Filters from '../components/Filters.tsx';
import LeadForm from '../components/LeadForm.astro';
import Faq from '../components/Faq.astro';
import { publicLofts, verifiedLofts, datesAreFresh } from '../lib/data';
import { stats } from '../lib/stats';
import { metroLinks, MAX_CARDS } from '../lib/pages';
import MetroNav from '../components/MetroNav.astro';
import { faqLd, breadcrumbLd, itemListLd } from '../lib/jsonld';
import { fmt } from '../lib/price';

const all = publicLofts();
const v = verifiedLofts().filter((l) => l.price_evening_30).sort((a, b) => a.price_evening_30! - b.price_evening_30!);
const s = stats(all);
const top = v.slice(0, 20);
const rest = [...top, ...all.filter((l) => !top.includes(l)).sort((a, b) => (a.price_hour_from ?? 1e9) - (b.price_hour_from ?? 1e9))];
const shown = rest.slice(0, MAX_CARDS);
const withDates = v.filter((l) => datesAreFresh(l));
const built = new Date().toISOString().slice(0, 10);
const d = (x: string) => x.slice(8, 10) + '.' + x.slice(5, 7);
const faq = [
  { q: 'Сколько стоит корпоратив в лофте на 30 человек?', a: s.median30 ? `Медиана по ${s.verified} проверенным лофтам — ${fmt(s.median30)} за вечер (суббота декабря, 18:00–23:00) с минимумом часов и уборкой; разброс от ${fmt(s.min30!)} до ${fmt(s.max30!)}. Это ${fmt(Math.round(s.median30 / 30))} на человека за площадку, без еды и напитков. Подробнее — в <a href="/ceny/korporativ-2026/">исследовании цен</a>.` : 'Собираем проверенные цены по каждой площадке; ориентир появится после первых проверок.' },
  { q: 'Когда бронировать лофт на новогодний корпоратив?', a: 'Пиковые даты — пятницы и субботы 12–26 декабря; популярные площадки в центре разбирают к середине ноября. На будни 15–25 декабря места есть дольше, а цена часто ниже на 20–30%. В карточках проверенных лофтов видны свободные даты.' },
  { q: 'Можно ли свой алкоголь и свой кейтеринг?', a: s.shareOwnAlcohol != null ? `${s.shareOwnAlcohol}% проверенных лофтов разрешают свой алкоголь (часть — с пробковым сбором 3–5 тыс. ₽), ${s.shareOwnCatering ?? '—'}% — свою еду. Смотрите фильтр «свой алкоголь» и <a href="/so-svoim-alkogolem/">отдельную подборку</a>.` : 'У каждого лофта в карточке указано: свой алкоголь, пробковый сбор, своя еда.' },
  { q: 'До скольки можно шуметь?', a: 'По закону Москвы тишина с 23:00 до 07:00 в жилых домах. Лофты в нежилых зданиях и на территориях бывших заводов обычно разрешают музыку до 02:00–06:00; у лофтов в жилых домах — до 23:00. В карточке это поле «Шум после 23:00».' },
  { q: 'Какой залог и что входит в цену?', a: `Залог обычно ${s.medianDeposit ? fmt(s.medianDeposit) : '10–20 тыс. ₽'} и возвращается после мероприятия. В нашу «цену за вечер» входят аренда с учётом минимума часов и уборка; пробковый сбор показывается отдельно в калькуляторе.` },
  { q: 'Есть ли наценка на новогодние даты?', a: 'У части площадок с 20 по 31 декабря ставка выше на 20–50%. Если наценка есть, она указана в карточке и учтена в калькуляторе при включённой галочке «декабрь».' },
];
const crumbs = [{ name: 'Лофты Москвы', path: '/' }, { name: 'Корпоратив', path: '/korporativ/' }];
---
<Base title={`Лофты на корпоратив в Москве: свободные даты декабря и реальная цена за вечер — LoftMap`}
      description={`${s.verified} проверенных лофтов для новогоднего корпоратива в Москве: итоговая цена за вечер на 30 человек${s.median30 ? ` (медиана ${fmt(s.median30)})` : ''}, свободные даты декабря, свой алкоголь, шум после 23:00. Без комиссии.`}
      jsonLd={[faqLd(faq), breadcrumbLd(crumbs), itemListLd('Лофты на корпоратив в Москве', v)]}>
  <nav class="text-sm text-ink/60 mb-3"><a href="/" class="hover:text-brick">Лофты Москвы</a> › Корпоратив</nav>
  <h1 class="text-3xl sm:text-4xl font-bold tracking-tight">Лофты на корпоратив в Москве: свободные даты декабря и реальная цена за вечер</h1>
  <p class="mt-3 text-lg text-ink/80 max-w-3xl">
    {s.verified > 0
      ? `${s.verified} лофтов проверены лично: цена за вечер на 30 человек с минимумом часов и уборкой${s.median30 ? ` (медиана ${fmt(s.median30)})` : ''}, свободные даты с 10 по 30 декабря, свой алкоголь и кейтеринг, шум после 23:00.`
      : `${s.total} лофтов Москвы с адресами, метро, вместимостью и ставками «от» с сайтов площадок. Идёт обзвон: у проверенных появятся итоговая цена за вечер на 30 человек и свободные даты декабря.`} Контакты открыты, комиссии нет. Данные на {built}.
  </p>

  {withDates.length > 0 && <section class="mt-8">
    <h2 class="text-2xl font-semibold mb-3">Ещё свободны в декабре</h2>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead><tr><th class="text-left py-2 pr-3 border-b border-ink/20">Лофт</th><th class="text-left py-2 pr-3 border-b border-ink/20">Метро</th><th class="text-left py-2 pr-3 border-b border-ink/20">До, чел</th><th class="text-left py-2 pr-3 border-b border-ink/20">Вечер на 30</th><th class="text-left py-2 pr-3 border-b border-ink/20">Свободно</th><th class="text-left py-2 border-b border-ink/20">Алкоголь</th></tr></thead>
        <tbody>{withDates.map((l) => <tr>
          <td class="py-2 pr-3 border-b border-ink/10"><a href={`/loft/${l.id}/`} class="text-brick font-medium">{l.name}</a></td>
          <td class="py-2 pr-3 border-b border-ink/10">{l.metro[0]}</td>
          <td class="py-2 pr-3 border-b border-ink/10">{Math.max(l.cap_seated ?? 0, l.cap_standing ?? 0)}</td>
          <td class="py-2 pr-3 border-b border-ink/10 font-semibold whitespace-nowrap">{fmt(l.price_evening_30!)}</td>
          <td class="py-2 pr-3 border-b border-ink/10">{l.free_dates_dec.map(d).join(', ')}</td>
          <td class="py-2 border-b border-ink/10">{l.corkage?.kind === 'free' ? 'свой' : l.corkage?.kind === 'fee' ? `свой, +${fmt(l.corkage.fee!)}` : 'нет'}</td>
        </tr>)}</tbody>
      </table>
    </div>
  </section>}

  <section class="mt-10">
    <h2 class="text-2xl font-semibold mb-3">{v.length ? 'Проверенные лофты по цене за вечер' : 'Лофты для корпоратива по ставке «от»'}</h2>
    <Filters client:load total={shown.length} />
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">{shown.map((l) => <LoftCard loft={l} />)}</div>
    <MetroNav total={rest.length} shown={shown.length} links={metroLinks(all)} />
  </section>

  <div class="mt-10"><LeadForm /></div>
  <Faq items={faq} title="Вопросы про корпоратив в лофте" />
</Base>
