---
import type { Loft } from '../lib/data';
import { datesAreFresh } from '../lib/data';
import { fmt } from '../lib/price';
interface Props { loft: Loft }
const { loft: l } = Astro.props;
const cap = Math.max(l.cap_seated ?? 0, l.cap_standing ?? 0) || null;
const fresh = datesAreFresh(l);
const d = (s: string) => s.slice(8, 10) + '.' + s.slice(5, 7);
---
<article class="card flex flex-col gap-2"
  data-card
  data-cap={cap ?? ''}
  data-metro={l.metro.join('|')}
  data-district={l.district}
  data-evening={l.price_evening_30 ?? ''}
  data-alcohol={l.corkage ? (l.corkage.kind === 'no' ? 'no' : 'yes') : ''}
  data-catering={l.own_catering == null ? '' : l.own_catering ? 'yes' : 'no'}
  data-noise={l.noise_after_23 ?? ''}
  data-dates={fresh ? 'yes' : 'no'}
  data-verified={l.status === 'verified' ? 'yes' : 'no'}>
  <div class="flex items-start justify-between gap-2">
    <h3 class="text-lg font-semibold leading-tight"><a href={`/loft/${l.id}/`} class="hover:text-brick">{l.name}</a></h3>
    {l.status === 'verified'
      ? <span class="badge bg-green-100 text-green-800 shrink-0">Проверено {d(l.checked_at)}</span>
      : <span class="badge bg-ink/5 text-ink/60 shrink-0">не проверено</span>}
  </div>
  <p class="text-sm text-ink/70">м. {l.metro.join(', ')}{l.metro_walk_min ? ` · ${l.metro_walk_min} мин` : ''} · {l.district}</p>
  <dl class="grid grid-cols-2 gap-x-3 gap-y-1 text-sm">
    {cap && <><dt class="text-ink/60">Вместимость</dt><dd>до {cap} чел{l.cap_seated ? ` (${l.cap_seated} сидя)` : ''}</dd></>}
    {l.price_evening_30
      ? <><dt class="text-ink/60">Вечер на 30 чел</dt><dd class="font-semibold">{fmt(l.price_evening_30)}</dd></>
      : l.price_hour_from ? <><dt class="text-ink/60">Цена</dt><dd>от {fmt(l.price_hour_from)}/час</dd></> : null}
    {l.corkage && <><dt class="text-ink/60">Свой алкоголь</dt><dd>{l.corkage.kind === 'free' ? 'да, бесплатно' : l.corkage.kind === 'fee' ? `да, сбор ${fmt(l.corkage.fee!)}` : 'нет'}</dd></>}
    {l.own_catering != null && <><dt class="text-ink/60">Своя еда</dt><dd>{l.own_catering ? 'да' : 'нет'}</dd></>}
  </dl>
  {fresh && <p class="text-sm"><span class="text-green-700 font-medium">Свободно в декабре:</span> {l.free_dates_dec.map(d).join(', ')}</p>}
  <div class="mt-auto flex gap-2 pt-1">
    <a href={`/loft/${l.id}/`} class="btn-ghost text-sm py-1.5">Подробнее</a>
    {l.phone && <a href={`tel:${l.phone}`} data-track="contact_click" data-loft={l.id} class="btn text-sm py-1.5">Позвонить</a>}
    {!l.phone && l.telegram && <a href={`https://t.me/${l.telegram}`} data-track="contact_click" data-loft={l.id} class="btn text-sm py-1.5" rel="nofollow">Telegram</a>}
  </div>
</article>
